APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_FRONTEND_URL=http://localhost:8080

DB_DRIVER=sqlite
DB_DATABASE=database/vlab.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PREFIX=

JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGO=HS256
JWT_ISSUER=vlab

LDAP_MODE=fake

LDAP_HOST=
LDAP_PORT=389
LDAP_ENCRYPTION=none
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

STORAGE_PATH=storage
UPLOAD_MAX_BYTES=10485760
LOG_LEVEL=debug
